MODEL_PROVIDER=mock
# dot | gemini | mock. Credentials stay on the Python backend.
DOT_API_KEY=
DOT_BASE_URL=https://note3-prev-api.askdiandian.com/v1
DOT_MODEL=dots3-note-prev
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAISON_DB=.local/maison.sqlite3
AGENT_PORT=8008
WEB_PORT=3008
# DOT model budgets, in seconds. First-token latency and inter-chunk stalls are
# bounded separately, so a slow-but-progressing run is never cut off.
MAISON_FIRST_TOKEN_TIMEOUT=75
MAISON_STREAM_IDLE_TIMEOUT=25
MAISON_MODEL_TIMEOUT=120
MAISON_MAX_OUTPUT_TOKENS=4096

